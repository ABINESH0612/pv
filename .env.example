PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# ============================================================
# RAZORPAY CONFIGURATION
# ============================================================
# For LIVE/Production: Replace with your actual Razorpay Key ID and Secret
# Get them from: https://dashboard.razorpay.com/app/keys
# ============================================================
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================================
# REAL-TIME EMAIL DELIVERY / SMTP CONFIGURATION
# ============================================================
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password (select 'Mail' / 'Other'):
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address as SMTP_USERNAME and SMTP_FROM_EMAIL.
# 4. Paste the 16-character App Password (without spaces) as SMTP_PASSWORD.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-sending-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-sending-gmail@gmail.com
SMTP_FROM_NAME="PV Nutrition Centre"
